# Copy this file to .env and fill in the values. .env is git-ignored.
# Only public values go here: anything starting with EXPO_PUBLIC_ is bundled into the app.
# Twilio and Claude API keys never go here; they live in Supabase Edge Function secrets (Phase 2+).

# Supabase project URL and public (anon) key — needed from Phase 2.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
